# Postgres connection strings from Supabase (or Vercel Postgres).
# Supabase gives you two: a pooled one (for the app, "Transaction" mode, port 6543)
# and a direct one (for migrations, port 5432). If you're using a provider that
# only gives one URL, use the same value for both.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Random long string used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
CRM_LEADS_API_URL="https://aarovia-api.vercel.app/api/leads/public"

# Used only once by `npm run db:seed` to create the first admin login.
# After the first login, change the password from the admin panel (or just
# create a new AdminUser and delete this one).
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-strong-password"
