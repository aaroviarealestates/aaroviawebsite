generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum PropertyCategory {
  LUXURY_APARTMENTS
  VILLA_PLOTS
  FARM_LANDS
  PREMIUM_VILLAS
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyRecordType {
  CATEGORY_PAGE
  NAMED_PROJECT
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Property {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  recordType      PropertyRecordType @default(CATEGORY_PAGE)
  websiteUrl      String?
  category        PropertyCategory
  displayCategory String?
  projectFilter   String?
  logo            String?
  sortOrder       Int                @default(0)
  location        String
  priceLabel      String? // e.g. "₹95 Lakh onwards" - free text, keeps pricing flexible
  bedrooms        Int?
  bathrooms       Int?
  areaSqft        Int?
  summary         String
  description     String
  coverImage      String
  gallery         String[]           @default([])
  amenities       String[]           @default([])
  featured        Boolean            @default(false)
  published       Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([recordType, published, featured, sortOrder])
}

model BlogPost {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImage     String
  coverImageAlt  String    @default("")
  author         String    @default("Aarovia Group")
  category       String    @default("Real Estate")
  postType       String    @default("ARTICLE")
  tags           String[]  @default([])
  published      Boolean   @default(true)
  featured       Boolean   @default(false)
  allowComments  Boolean   @default(true)
  publishedAt    DateTime  @default(now())
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  focusKeyword   String    @default("")
  deletedAt      DateTime?
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  quote     String
  avatar    String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String? // which page/form the lead came from
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}

model SiteContent {
  // simple key/value store for editable homepage copy (hero text, stats, etc.)
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
